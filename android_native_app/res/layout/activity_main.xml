<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090e">

    <!-- Camera Preview View -->
    <FrameLayout
        android:id="@+id/camera_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Custom Canvas for Drawing Face Bounding Boxes -->
    <com.facedetect.nativeai.FaceOverlayView
        android:id="@+id/face_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Live Counter HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/hud_counter_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hud_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/txt_face_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 0 FACES DETECTED"
                android:textColor="#f8fafc"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_face_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Camera AI Active · Point at faces"
                android:textColor="#06b6d4"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls HUD Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_flip_camera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/hud_background"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="🔄 Flip Camera"
            android:textColor="#ffffff"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_toggle_torch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hud_background"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="🔦 Flashlight"
            android:textColor="#ffffff"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
